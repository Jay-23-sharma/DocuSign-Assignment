# Replace the placeholders with your pgAdmin connection details.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

SMTP_ADDR=127.0.0.1:1025
FRONTEND_BASE_URL=http://127.0.0.1:5173

# Generate once with: openssl rand -base64 32
# Save the standard Base64 result privately and reuse it across restarts.
# Cookies use Secure except when FRONTEND_BASE_URL is an HTTP loopback origin.
SENDER_COOKIE_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES

# Relative to the backend working directory, or use an absolute private directory.
DOCUMENT_STORAGE_DIR=../storage/documents
PDF_MAX_BYTES=20971520

# Optional Python interpreter with PyGObject, Poppler, PangoCairo, and pycairo.
# PDF_RENDER_PYTHON=/usr/bin/python3

# Set this to the local Compose database password used in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
